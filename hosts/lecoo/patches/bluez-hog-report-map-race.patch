+static gboolean report_map_retry_cb(gpointer user_data)
+{
+	struct bt_hog *hog = user_data;
+
+	/* Keep the "Report Map is read last" invariant from
+	 * remove_gatt_req(): wait for the GATT queue to drain before
+	 * retrying, otherwise uhid_create() could run while report
+	 * attributes are still being resolved.
+	 */
+	if (!queue_isempty(hog->gatt_op)) {
+		DBG("HoG Report Map retry deferred: GATT queue busy");
+		return TRUE;
+	}
+
+	hog->report_map_retry_id = 0;
+
+	DBG("HoG retrying Report Map read");
+
+	read_report_map(hog);
+
+	return FALSE;
+}
+
 static void report_map_read_cb(guint8 status, const guint8 *pdu, guint16 plen,
 							gpointer user_data)
 {
@@ -1040,6 +1065,25 @@
 
 	if (status != 0) {
 		error("Report Map read failed: %s", att_ecode2str(status));
+		/* Clear the request id so the next attach retries the read.
+		 * read_report_map() skips the read while report_map_id is
+		 * set, and nothing else ever resets it, so a single failed
+		 * read would permanently leave this device without uHID.
+		 */
+		hog->report_map_id = 0;
+		/* A lost race against LE encryption used to leave the
+		 * device without uHID until the next attach, and nothing
+		 * re-triggers an attach while the link stays up.  Retry the
+		 * read once per second (bounded) so the failure self-heals
+		 * within the same connection.
+		 */
+		if (!hog->report_map_retry_id &&
+				hog->report_map_retry_count < 5) {
+			hog->report_map_retry_count++;
+			hog->report_map_retry_id = g_timeout_add_seconds(1,
+							report_map_retry_cb,
+							hog);
+		}
 		return;
 	}
 
